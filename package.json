		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@companion-module/tools": "^2.8.0",
		"@types/node": "^18.19.0",
		"@types/ws": "^8.5.12",
		"prettier": "^3.3.3",
		"typescript": "~5.4.5"
	},
	"prettier": "@companion-module/tools/.prettierrc.json"
